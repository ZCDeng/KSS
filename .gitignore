# Secrets / env
.env
.env.local
.env.*.local
!.env.example
# 分时数据层 token secrets（KSS_STATE_ROOT/secrets/，0600，绝不入库；plan 005 S5/KTD4）
secrets/
/secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node helper dependencies are reproduced from helpers/pi-ai/package-lock.json.
node_modules/

# Virtualenv
.venv/
.venv-*/
venv/
env/

# IDE / OS
.DS_Store
.idea/
.vscode/

# Claude / agents 私有状态(排内容而非目录本身,好让下面的 skills 例外生效)
.claude/*
# 例外:公开 Skill playbook 入库供任意 agent 用(#1-#3 能力面)
!.claude/skills/

# 个股/ETF/指数日线缓存（运行态，体积大）
# 唯一写盘路径：scripts/update_cs_data.py 与 cron run_update_data_daily.sh
# 绝不入库——已跟踪文件用 `git rm --cached 'cs_data_*.csv'` 脱钩，避免 checkout 冲掉日更。
/cs_data_*.csv
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.db-shm
storage/**/*.db-journal
storage/**/*.db-wal
storage/**/*.db-shm

# 审计底稿例外：storage/daily_review/ 与 storage/etf_radar/ 是预测校验
# (validate_predictions.py) 的依据，纳入版本控制；周五校验 cron 自动 commit
# 同类日级归档还包括 storage/sector_rotation/*.json、storage/paper_trade/*.json
# 与人工/研究报告 storage/reports/。这些路径不要用 storage/** 一刀切忽略。
# LLM commentary 边车、探针样本、本地状态和可重建 macro/cache 则属于运行态。
storage/etf_radar/.morning_alert_state
storage/etf_radar/*.commentary.md
storage/sector_rotation/probe/
storage/app_runs/
storage/macro/
storage/reports/.claude/

# Agent sessions, provider routes and scheduler markers are machine-local state.
# They can contain user conversation data or are regenerated by the pipeline;
# keep them out of commits while preserving versioned review, paper-trade and
# research-report evidence below.
storage/agent/
storage/intel_rewrites/
storage/intel_track_keywords.json
storage/kss.db.migration.lock
storage/pipeline_markers/

# 日志 / 临时
*.log
/tmp/*

# Jupyter
.ipynb_checkpoints/

# 临时回测产物（保留 storage/reports/ 的 *.md，不保留 png 中间结果）
*.parquet

# Kronos 离线产物：冻结模型 artifact + 预测 sqlite（可由批处理重建，不入库）
storage/kronos/

# 个股资金流 / 指数行情数据（体积大，由数据脚本重建，不入库）
mf_*.csv
idx_*.csv

# agent / 工具私有状态（同 .claude/）
.pi/
.omx/
.cache/
.codex/

# 构建产物（SwiftPM .build / 可重建，不入库）
.build/
.build-*/

# storage 缓存 / legacy（可重建，不入库）
storage/bj_cache/
storage/legacy/
storage/data_catalog.json

# cron 运行日志（wrapper 可能 echo TOKEN length，绝不入库；plan 005 cron-manifest 安全项）
storage/logs/cron/

# scan 排名输出（数据产物，可重建）
scan_*_rank.csv

# SwiftPM 桌面 app 构建产物
/dist/
storage/trends/

# 回测闭环运行时 DB(可重建，不入库)
storage/prediction_ledger/
storage/factor_health/
storage/cpcv_cache/
storage/pipeline_alpha/

# eval harness: cases/scorers/reports 可入库；逐次运行 trace 可重建
evals/**/traces/

# U5 sidecar socket (dev: repo/run/)
/run/

# bundle-mode 双击便利：state-root venv 软链(本机 dev)
/venv

# 舆情热点 digest 运行时归档(每场重生成,不入库)
storage/news_digest/
