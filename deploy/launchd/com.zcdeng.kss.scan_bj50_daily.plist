<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zcdeng.kss.scan_bj50_daily</string>

    <!-- 北证 50 全量扫描 + Telegram Top 5 推送 - 每个交易日 17:45
         (北证 15:00 收盘 + tushare 数据延迟 buffer + 在 combo_scan 17:40 之后 5 分钟) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zcdeng/projects/KSS/scripts/run_scan_bj50_daily.sh</string>
        <string>--push</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zcdeng/projects/KSS</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/zcdeng</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/zcdeng/projects/KSS/storage/logs/cron/scan_bj50_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zcdeng/projects/KSS/storage/logs/cron/scan_bj50_daily.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
