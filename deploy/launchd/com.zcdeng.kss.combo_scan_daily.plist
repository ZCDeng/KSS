<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zcdeng.kss.combo_scan_daily</string>

    <!-- 组合信号扫描 - 每个交易日 17:40 (在 sector_review 17:30 之后, 留 10 分钟 buffer) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>40</integer></dict>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zcdeng/projects/KSS/scripts/run_combo_scan_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zcdeng/projects/KSS</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/zcdeng</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/zcdeng/projects/KSS/storage/logs/cron/combo_scan_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zcdeng/projects/KSS/storage/logs/cron/combo_scan_daily.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
