<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zcdeng.kss.data_catalog_daily</string>

    <!-- 数据目录刷新 - 每日 8:50（macro 8:35 / cs_data 8:30 更新之后重建字典） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>50</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zcdeng/projects/KSS/scripts/run_data_catalog_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zcdeng/projects/KSS</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/zcdeng</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/zcdeng/projects/KSS/storage/logs/cron/data_catalog_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zcdeng/projects/KSS/storage/logs/cron/data_catalog_daily.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
